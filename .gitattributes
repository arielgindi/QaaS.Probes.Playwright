# LF everywhere, also in a Windows checkout: raw string literals in the code and its tests keep \n line ends.
* text=auto eol=lf
# The recorder's panel, built from Panel/ui into one minified file: rebuilt, never merged by hand.
QaaS.Playwright.Recorder/Panel/panel.html linguist-generated=true -diff
# Left out of release archives (GitHub's "Source code" zip), which only need to build: the panel's UI sources, as
# panel.html is built from them and committed, and the fixtures the tests record on real and sample sites.
QaaS.Playwright.Recorder/Panel/ui/** export-ignore
QaaS.Playwright.Tests/Recorder/RealSites/** export-ignore
QaaS.Playwright.Tests/Recorder/Sites/** export-ignore
QaaS.Playwright.Tests/Recorder/Pickers/** export-ignore
QaaS.Playwright.Tests/Recorder/Fuzz/** export-ignore
