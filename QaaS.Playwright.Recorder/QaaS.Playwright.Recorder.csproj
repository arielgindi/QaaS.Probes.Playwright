<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="QaaS.Playwright.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
        <!-- Override the vulnerable transitive MessagePack 3.1.4 (GHSA-hv8m-jj95-wg3x). -->
        <PackageReference Include="MessagePack" Version="3.1.7" />
        <ProjectReference Include="..\QaaS.Playwright\QaaS.Playwright.csproj" />
    </ItemGroup>

</Project>
