<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>QaaS.Assertions.Playwright</PackageId>
    <Authors>SmokeTeam</Authors>
    <Description>Playwright assertion plugin for QaaS — surfaces Playwright flow results (SessionFailures) into a QaaS assertion / Allure report.</Description>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <VersionPrefix>0.0.0</VersionPrefix>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QaaS.Framework.SDK" Version="1.4.0" />
  </ItemGroup>

  <!-- Pairs with the probe: reuses its PlaywrightFlowResults / PlaywrightFlowOutcome contract. -->
  <ItemGroup>
    <ProjectReference Include="..\QaaS.Probes.Playwright\QaaS.Probes.Playwright.csproj" />
  </ItemGroup>

</Project>
