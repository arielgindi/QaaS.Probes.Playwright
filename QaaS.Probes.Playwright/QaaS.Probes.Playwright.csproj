<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>QaaS.Probes.Playwright</PackageId>
        <Authors>SmokeTeam</Authors>
        <Description>Playwright browser automation probe for QaaS test workflows.</Description>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <VersionPrefix>1.0.0</VersionPrefix>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="browser-defaults.yaml" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\QaaS.Probes.Playwright.Contracts\QaaS.Probes.Playwright.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
        <PackageReference Include="QaaS.Framework.Configurations" Version="1.4.0" />
        <PackageReference Include="QaaS.Framework.SDK" Version="1.4.0" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
        <!-- Override the vulnerable transitive MessagePack 3.1.4 (GHSA-hv8m-jj95-wg3x) pulled in by
             QaaS.Framework.Serialization with a patched build. -->
        <PackageReference Include="MessagePack" Version="3.1.7" />
    </ItemGroup>

</Project>
