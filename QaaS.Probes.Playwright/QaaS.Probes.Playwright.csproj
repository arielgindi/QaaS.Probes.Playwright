<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>QaaS.Probes.Playwright</PackageId>
        <Authors>SmokeTeam</Authors>
        <Description>Playwright browser automation probe for QaaS test workflows.</Description>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <VersionPrefix>0.0.0</VersionPrefix>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="browser-defaults.yaml" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright" Version="1.52.0" />
        <PackageReference Include="QaaS.Framework.Configurations" Version="1.4.0" />
        <PackageReference Include="QaaS.Framework.SDK" Version="1.4.0" />
        <PackageReference Include="YamlDotNet" Version="16.2.1" />
    </ItemGroup>

</Project>
